<Window x:Class="RemoteOpsTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="RemoteOpsTool - 域环境远程运维工具"
        Height="690" Width="1420"
        MinHeight="520" MinWidth="1120"
        Icon="pack://application:,,,/Views/Resources/Tools.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:LogLevelToColorConverter x:Key="LogLevelToColor" />
        <converters:ConnectionStatusToColorConverter x:Key="ConnectionStatusToColor" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
            <StackPanel Margin="10">

                <!-- Icon + Version -->
                <StackPanel Margin="0,4,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Image x:Name="AppIcon" Width="44" Height="44" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="运维工具箱" FontSize="20" FontWeight="Bold" Foreground="#1E90FF" />
                            <TextBlock Text="v1.0" FontSize="11" Foreground="#888" Margin="2,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CONNECTION -->
                <Border Background="#1A2540" CornerRadius="4" Padding="12,8,12,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="连接管理" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4" />
                        <TextBlock Text="输入目标主机名" FontSize="11" Foreground="#4ECB71" Margin="0,0,0,3" />
                        <TextBox x:Name="TargetHostBox" Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" Margin="0,0,0,8" LostFocus="TargetHostBox_LostFocus"
                                 TextChanged="TargetHostBox_TextChanged" />
                        <UniformGrid Columns="2">
                            <Button Content="Ping 测试" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding Connection.PingCommand}" />
                            <Button Content="能力探测" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding Connection.ProbeCapabilitiesCommand}" />
                            <Button Content="{Binding Connection.ContinuousPingButtonText}" Margin="2"
                                    Height="30" Command="{Binding Connection.ContinuousPingCommand}"
                                    FontSize="13" FontFamily="{StaticResource UiFont}" Cursor="Hand"
                                    Foreground="#FFF">
                                <Button.Background>
                                    <SolidColorBrush Color="{Binding Connection.ContinuousPingActiveColor}" />
                                </Button.Background>
                                <Button.BorderBrush>
                                    <SolidColorBrush Color="{Binding Connection.ContinuousPingBorderColor}" />
                                </Button.BorderBrush>
                            </Button>
                            <Button Content="远程桌面" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding Connection.DameWareConnectCommand}" />
                            <Button Content="凭据管理" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding Connection.OpenCredentialDialogCommand}" />
                            <Button Content="清除凭据" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding Connection.ClearCredentialsCommand}" />
                            <Button Content="断开连接" Style="{StaticResource BtnRed}" Margin="2" Command="{Binding DisconnectCommand}" FontSize="13">
                                <Button.Visibility>
                                    <Binding Path="IsConnected" Converter="{StaticResource BoolToVisibilityConverter}" />
                                </Button.Visibility>
                            </Button>
                            <Button Content="重新连接" Style="{StaticResource BtnGreen}" Margin="2" Command="{Binding ReconnectCommand}" FontSize="13">
                                <Button.Visibility>
                                    <Binding Path="IsConnected" Converter="{StaticResource BoolToVisibilityConverter}" ConverterParameter="Invert" />
                                </Button.Visibility>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- FILE DISK -->
                <Border Background="#1A2A20" CornerRadius="4" Padding="12,8,12,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="文件与磁盘" FontSize="14" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8" />
                        <Button Content="域公共目录" Style="{StaticResource BtnGreen}" Margin="2" Command="{Binding FileDisk.OpenDomainPublicCommand}" />
                        <StackPanel IsEnabled="{Binding IsRemoteEnabled}">
                            <Grid Margin="0,0,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="打开C盘" Style="{StaticResource BtnGreen}" Margin="2" Command="{Binding FileDisk.OpenCRootCommand}" />
                                <Button Grid.Column="1" Content="公共桌面" Style="{StaticResource BtnGreen}" Margin="2" Command="{Binding FileDisk.OpenPublicDesktopCommand}" />
                                <Button Grid.Row="1" Grid.ColumnSpan="2" Content="清理空间" Style="{StaticResource BtnGreen}" Margin="2" Command="{Binding FileDisk.OpenDiskCleanupCommand}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding FileDisk.DriveLetters}" SelectedItem="{Binding FileDisk.SelectedDrive}" Height="30" />
                                <Button Grid.Column="1" Content="打开所选盘符" Style="{StaticResource BtnGreen}" Margin="4,0,0,0" Command="{Binding FileDisk.OpenSelectedDriveCommand}" />
                            </Grid>
                            <Button Content="获取所有磁盘信息" Style="{StaticResource BtnGreen}" Margin="0,2,0,0" Command="{Binding FileDisk.GetDiskInfoCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- REMOTE MANAGEMENT -->
                <Border Background="#201A30" CornerRadius="4" Padding="12,8,12,12" Margin="0,0,0,10"
                        IsEnabled="{Binding IsRemoteEnabled}">
                    <StackPanel>
                        <TextBlock Text="远程管理" FontSize="14" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,8" />
                        <UniformGrid Columns="2" Rows="4">
                            <Button Content="设备管理" Style="{StaticResource BtnOrange}" Margin="2" Command="{Binding RemoteManagement.OpenDeviceManagerCommand}" />
                            <Button Content="服务管理" Style="{StaticResource BtnOrange}" Margin="2" Command="{Binding RemoteManagement.OpenServiceManagerCommand}" />
                            <Button Content="打印机" Style="{StaticResource BtnOrange}" Margin="2" Command="{Binding RemoteManagement.OpenPrinterManagerCommand}" />
                            <Button Content="软件管理" Style="{StaticResource BtnOrange}" Margin="2" Command="{Binding RemoteManagement.OpenSoftwareManagerCommand}" />
                            <Button Content="环境变量" Style="{StaticResource BtnOrange}" Margin="2" Command="{Binding RemoteManagement.OpenEnvVarEditorCommand}" />
                            <Button Content="系统信息" Style="{StaticResource BtnOrange}" Margin="2" Command="{Binding RemoteManagement.OpenSystemInfoCommand}" />
                            <Button Content="注册表" Style="{StaticResource BtnOrange}" Margin="2" Command="{Binding RemoteManagement.OpenRegistryCommand}" />
                            <Button Content="用户和组" Style="{StaticResource BtnOrange}" Margin="2" Command="{Binding RemoteManagement.OpenUsersGroupsCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- INTERACTIVE -->
                <Border Background="#1A2B28" CornerRadius="4" Padding="12,8,12,12" Margin="0,0,0,10"
                        IsEnabled="{Binding IsRemoteEnabled}">
                    <StackPanel>
                        <TextBlock Text="发送交互程序" FontSize="14" FontWeight="Bold" Foreground="#2DD4BF" Margin="0,0,0,8" />
                        <UniformGrid Columns="2" Rows="2">
                            <Button Content="命令行" Style="{StaticResource BtnCyan}" Margin="2" Command="{Binding Interactive.LaunchCmdCommand}" />
                            <Button Content="计算机管理" Style="{StaticResource BtnCyan}" Margin="2" Command="{Binding Interactive.LaunchComputerMgmtCommand}" />
                            <Button Content="打印机管理" Style="{StaticResource BtnCyan}" Margin="2" Command="{Binding Interactive.LaunchPrinterMgmtCommand}" />
                            <Button Content="注册表" Style="{StaticResource BtnCyan}" Margin="2" Command="{Binding Interactive.LaunchRegEditCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- NETWORK -->
                <Border Background="#1A1A30" CornerRadius="4" Padding="12,8,12,12" Margin="0,0,0,10"
                        IsEnabled="{Binding IsRemoteEnabled}">
                    <StackPanel>
                        <TextBlock Text="网络工具" FontSize="14" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8" />
                        <UniformGrid Columns="3" Rows="1">
                            <Button Content="刷新DNS" Style="{StaticResource BtnPurple}" Margin="2" Command="{Binding Network.FlushDnsCommand}" />
                            <Button Content="刷新IP" Style="{StaticResource BtnPurple}" Margin="2" Command="{Binding Network.RefreshIpCommand}" />
                            <Button Content="进程管理" Style="{StaticResource BtnPurple}" Margin="2" Command="{Binding Network.OpenPortManagerCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- SETTINGS -->
                <Button Content="高级设置" Command="{Binding OpenSettingsCommand}"
                        Height="38" FontSize="14" Margin="0,4,0,12"
                        Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="8,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1872B3" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#5BB8F0" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0A4F7A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#3C3C3C" />

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="2" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>

            <!-- STATUS BAR -->
            <Border Grid.Row="0" Background="#252526" CornerRadius="3" Padding="14,10" Margin="0,0,0,8" BorderBrush="#3C3C3C" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                               FontSize="16" FontWeight="Bold" Foreground="#1E90FF">
                        <Run Text="目标主机：" /><Run Text="{Binding StatusBar.HostName, Mode=OneWay}" />
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" VerticalAlignment="Center"
                                 Fill="#FF6B6B" />
                        <TextBlock Text="{Binding StatusBar.PingStatus}" FontSize="13"
                                   Foreground="{Binding StatusBar.ConnectionDotColor}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Text=" " FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusBar.ConnectionStatusText}" FontSize="16" FontWeight="Bold"
                                   Foreground="{Binding StatusBar.ConnectionStatusColor}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="磁盘容量" FontSize="16" FontWeight="Bold" Foreground="#4ECB71" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock Text="C盘：" Foreground="#6BAADD" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusBar.CDriveInfo}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="D盘：" Foreground="#6BAADD" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusBar.DDriveInfo}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding StatusBar.CurrentTime}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="Bold" Foreground="#1E90FF" />
                </Grid>
            </Border>

            <!-- LOG AREA -->
            <Border Grid.Row="1" Background="#000" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8" Background="#111">
                        <TextBlock Text="日志级别：" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#4ECB71" />
                        <ComboBox ItemsSource="{Binding Log.LogLevels}" SelectedItem="{Binding Log.SelectedFilterLevel}" Width="80" Height="24" FontSize="12" />
                        <Button Content="清空日志" Command="{Binding Log.ClearLogCommand}" Width="80" Height="30" FontSize="12" Margin="16,0,0,0" Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4" />
                        <Button Content="复制日志" Click="CopyLogButton_Click" Width="80" Height="30" FontSize="12" Margin="8,0,0,0" Background="#1A6E3E" Foreground="#FFF" BorderBrush="#2EA85A" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0A1A2A" Padding="6,3" Margin="2,2,2,0" CornerRadius="3">
                        <TextBlock Text="拖拽脚本文件到此可发送到目标主机远程执行"
                                   FontSize="14" Foreground="#5BA0D9" HorizontalAlignment="Center" />
                    </Border>
                    <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3"
                                 Visibility="{Binding Log.IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="2,0,2,0" Foreground="#4ECB71" Background="#333" />

                    <RichTextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" Background="#000" Foreground="#4ECB71" BorderThickness="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 IsUndoEnabled="False">
                        <RichTextBox.ContextMenu>
                            <ContextMenu Background="#1E1E1E" BorderBrush="#555" Foreground="#E0E0E0" Padding="2"
                                         FontSize="13" FontFamily="{StaticResource UiFont}"
                                         SnapsToDevicePixels="True">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="#1E1E1E" BorderBrush="#3C3C3C"
                                                BorderThickness="1" CornerRadius="4" Padding="2">
                                            <StackPanel IsItemsHost="True" />
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="OverridesDefaultStyle" Value="True" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#E0E0E0" />
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            BorderThickness="0"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter ContentSource="Header"
                                                                          RecognizesAccessKey="True"
                                                                          Margin="0"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#3A7BD5" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#666" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="复制   Ctrl+C" Click="LogCopyMenuItem_Click" />
                                <Separator Height="1" Margin="0,3">
                                    <Separator.Template>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Background="#3C3C3C" Height="1" Margin="14,0" />
                                        </ControlTemplate>
                                    </Separator.Template>
                                </Separator>
                                <MenuItem Header="全选   Ctrl+A" Click="LogSelectAllMenuItem_Click" />
                                <MenuItem Header="清空日志" Click="LogClearMenuItem_Click" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </Grid>
            </Border>

            <!-- COMMAND TERMINAL -->
            <Border Grid.Row="3" Background="#000" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="3" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: title + interactive controls on same baseline -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="远程命令终端输入区" FontSize="14" FontWeight="Bold" Foreground="#5BA0D9" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="交互执行" IsChecked="{Binding Terminal.IsInteractiveMode}"
                                      Foreground="#DCDCDC" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Terminal.AvailableSessions}"
                                      SelectedItem="{Binding Terminal.SelectedSession}"
                                      Width="170" Height="26"
                                      Background="#1A1A1A" Foreground="#E0E0E0" BorderBrush="#555"
                                      FontSize="11" VerticalContentAlignment="Center"
                                      Visibility="{Binding Terminal.IsInteractiveMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" x:Name="TerminalInputBox"
                             Text="{Binding Terminal.CommandText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Background="#000" Foreground="#0F0" BorderThickness="0"
                             FontFamily="{StaticResource MonoFont}" FontSize="13" AllowDrop="True"
                             PreviewKeyDown="TerminalInputBox_PreviewKeyDown" />

                    <!-- Row 2: buttons (right aligned) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="加载脚本" Command="{Binding Terminal.LoadScriptCommand}"
                                Width="85" Height="28" Background="#8C5A1E" Foreground="#FFF" BorderBrush="#BF8030" />
                        <Button Content="执行" Command="{Binding Terminal.ExecuteCommandCommand}" Width="75" Height="28" Margin="8,0,0,0"
                                Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
