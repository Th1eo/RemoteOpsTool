<Window x:Class="RemoteOpsTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="RemoteOpsTool - 域环境远程运维工具"
        Height="720" Width="1440"
        MinHeight="560" MinWidth="1120"
        Icon="pack://application:,,,/Views/Resources/Tools.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:LogLevelToColorConverter x:Key="LogLevelToColor" />
        <converters:ConnectionStatusToColorConverter x:Key="ConnectionStatusToColor" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ToolCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceDarkElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceDarkElevatedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="DarkPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceDarkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceDarkElevatedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="ToolCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{StaticResource OnDarkSoftBrush}" />
        </Style>

        <Style x:Key="StatusMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SurfaceDarkBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="344" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <!-- Icon + Version -->
                    <Border Background="{StaticResource SurfaceDarkElevatedBrush}" BorderBrush="{StaticResource SurfaceDarkElevatedBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="2" Background="{StaticResource SurfaceDarkBrush}" Padding="6" Margin="0,0,10,0">
                                <Image x:Name="AppIcon" Width="32" Height="32" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="RemoteOpsTool" Style="{StaticResource DisplayTitle}" FontSize="20" LineHeight="24" />
                                <TextBlock Text="域环境远程运维控制台 · v1.4.27" TextWrapping="NoWrap" Style="{StaticResource CaptionText}" Margin="2,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CONNECTION -->
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="连接管理" Style="{StaticResource SectionHeader}" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="目标主机" Style="{StaticResource ToolCaption}" />
                            <TextBox x:Name="TargetHostBox" Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" FontWeight="SemiBold"
                                     Margin="0,0,0,8" LostFocus="TargetHostBox_LostFocus"
                                     TextChanged="TargetHostBox_TextChanged" />
                            <UniformGrid Columns="2">
                                <Button Content="Ping 测试" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding Connection.PingCommand}" />
                                <Button Content="能力探测" Style="{StaticResource BtnPurple}" Margin="2" Command="{Binding Connection.ProbeCapabilitiesCommand}" />
                                <Button Content="{Binding Connection.ContinuousPingButtonText}" Margin="2"
                                        Height="36" Command="{Binding Connection.ContinuousPingCommand}"
                                        FontSize="14" FontFamily="{StaticResource UiFont}" Cursor="Hand"
                                        Foreground="{StaticResource OnPrimaryBrush}">
                                    <Button.Background>
                                        <SolidColorBrush Color="{Binding Connection.ContinuousPingActiveColor}" />
                                    </Button.Background>
                                    <Button.BorderBrush>
                                        <SolidColorBrush Color="{Binding Connection.ContinuousPingBorderColor}" />
                                    </Button.BorderBrush>
                                </Button>
                                <Button Content="远程桌面" Style="{StaticResource BtnCyan}" Margin="2" Command="{Binding Connection.DameWareConnectCommand}" />
                                <Button Content="凭据管理" Style="{StaticResource BtnIndigo}" Margin="2" Command="{Binding Connection.OpenCredentialDialogCommand}" />
                                <Button Content="清除凭据" Style="{StaticResource BtnRed}" Margin="2" Command="{Binding Connection.ClearCredentialsCommand}" />
                                <Button Content="断开连接" Style="{StaticResource BtnMagenta}" Margin="2" Command="{Binding DisconnectCommand}" FontSize="14">
                                    <Button.Visibility>
                                        <Binding Path="IsConnected" Converter="{StaticResource BoolToVisibilityConverter}" />
                                    </Button.Visibility>
                                </Button>
                                <Button Content="重新连接" Style="{StaticResource BtnGreen}" Margin="2" Command="{Binding ReconnectCommand}" FontSize="14">
                                    <Button.Visibility>
                                        <Binding Path="IsConnected" Converter="{StaticResource BoolToVisibilityConverter}" ConverterParameter="Invert" />
                                    </Button.Visibility>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- FILE DISK -->
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="文件与磁盘" Style="{StaticResource SectionHeader}" Foreground="{StaticResource PrimaryBrush}" />
                            <Button Content="域公共目录" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding FileDisk.OpenDomainPublicCommand}" />
                            <StackPanel IsEnabled="{Binding IsRemoteEnabled}" Margin="0,6,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="打开 C 盘" Style="{StaticResource BtnCyan}" Margin="2" Command="{Binding FileDisk.OpenCRootCommand}" />
                                    <Button Grid.Column="1" Content="公共桌面" Style="{StaticResource BtnPurple}" Margin="2" Command="{Binding FileDisk.OpenPublicDesktopCommand}" />
                                    <Button Grid.Row="1" Grid.ColumnSpan="2" Content="清理空间" Style="{StaticResource BtnLime}" Margin="2" Command="{Binding FileDisk.OpenDiskCleanupCommand}" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding FileDisk.DriveLetters}" SelectedItem="{Binding FileDisk.SelectedDrive}" Height="32" />
                                    <Button Grid.Column="1" Content="打开所选盘符" Style="{StaticResource BtnIndigo}" Margin="6,0,0,0" Command="{Binding FileDisk.OpenSelectedDriveCommand}" />
                                </Grid>
                                <Button Content="获取所有磁盘信息" Style="{StaticResource BtnMagenta}" Margin="0,2,0,0" Command="{Binding FileDisk.GetDiskInfoCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- REMOTE MANAGEMENT -->
                    <Border Style="{StaticResource ToolCard}" IsEnabled="{Binding IsRemoteEnabled}">
                        <StackPanel>
                            <TextBlock Text="远程管理" Style="{StaticResource SectionHeader}" Foreground="{StaticResource PrimaryBrush}" />
                            <UniformGrid Columns="2" Rows="5">
                                <Button Content="设备管理" Style="{StaticResource BtnLime}" Margin="2" Command="{Binding RemoteManagement.OpenDeviceManagerCommand}" />
                                <Button Content="服务管理" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding RemoteManagement.OpenServiceManagerCommand}" />
                                <Button Content="打印机" Style="{StaticResource BtnMagenta}" Margin="2" Command="{Binding RemoteManagement.OpenPrinterManagerCommand}" />
                                <Button Content="软件管理" Style="{StaticResource BtnPurple}" Margin="2" Command="{Binding RemoteManagement.OpenSoftwareManagerCommand}" />
                                <Button Content="环境变量" Style="{StaticResource BtnCyan}" Margin="2" Command="{Binding RemoteManagement.OpenEnvVarEditorCommand}" />
                                <Button Content="系统信息" Style="{StaticResource BtnGreen}" Margin="2" Command="{Binding RemoteManagement.OpenSystemInfoCommand}" />
                                <Button Content="注册表" Style="{StaticResource BtnIndigo}" Margin="2" Command="{Binding RemoteManagement.OpenRegistryCommand}" />
                                <Button Content="计算机管理" Style="{StaticResource BtnRed}" Margin="2" Command="{Binding RemoteManagement.OpenComputerManagementCommand}" />
                                <Button Content="打印管理" Style="{StaticResource BtnMagenta}" Margin="2" Command="{Binding RemoteManagement.OpenPrintManagementCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- INTERACTIVE -->
                    <Border Style="{StaticResource ToolCard}" IsEnabled="{Binding IsRemoteEnabled}">
                        <StackPanel>
                            <TextBlock Text="发送交互程序" Style="{StaticResource SectionHeader}" Foreground="{StaticResource PrimaryBrush}" />
                            <UniformGrid Columns="2" Rows="3">
                                <Button Content="命令行" Style="{StaticResource BtnCyan}" Margin="2" Command="{Binding Interactive.LaunchCmdCommand}" />
                                <Button Content="PowerShell 程序" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding Interactive.LaunchPowerShellCommand}" />
                                <Button Content="计算机管理" Style="{StaticResource BtnPurple}" Margin="2" Command="{Binding Interactive.LaunchComputerMgmtCommand}" />
                                <Button Content="打印机管理" Style="{StaticResource BtnIndigo}" Margin="2" Command="{Binding Interactive.LaunchPrinterMgmtCommand}" />
                                <Button Content="注册表" Style="{StaticResource BtnMagenta}" Margin="2" Command="{Binding Interactive.LaunchRegEditCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- NETWORK -->
                    <Border Style="{StaticResource ToolCard}" IsEnabled="{Binding IsRemoteEnabled}">
                        <StackPanel>
                            <TextBlock Text="网络工具" Style="{StaticResource SectionHeader}" Foreground="{StaticResource PrimaryBrush}" />
                            <UniformGrid Columns="3" Rows="1">
                                <Button Content="刷新 DNS" Style="{StaticResource BtnBlue}" Margin="2" Command="{Binding Network.FlushDnsCommand}" />
                                <Button Content="刷新 IP" Style="{StaticResource BtnRed}" Margin="2" Command="{Binding Network.RefreshIpCommand}" />
                                <Button Content="进程管理" Style="{StaticResource BtnGreen}" Margin="2" Command="{Binding Network.OpenPortManagerCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- SETTINGS -->
                    <Button Content="高级设置" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="40" FontSize="14" Margin="0,4,0,12" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource SurfaceDarkElevatedBrush}" />

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="2" Margin="10"
              AllowDrop="True" PreviewDragOver="ScriptDrop_PreviewDragOver" Drop="ScriptDrop_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="164" />
            </Grid.RowDefinitions>

            <!-- STATUS BAR -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceDarkElevatedBrush}" CornerRadius="3" Padding="12,10" Margin="0,0,0,8"
                    AllowDrop="True" PreviewDragOver="ScriptDrop_PreviewDragOver" Drop="ScriptDrop_Drop"
                    BorderBrush="{StaticResource SurfaceDarkElevatedBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="目标主机" Style="{StaticResource StatusMetricLabel}" Margin="0,0,0,2" Foreground="{StaticResource OnDarkBrush}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OnDarkBrush}">
                            <Run Text="{Binding StatusBar.HostName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" VerticalAlignment="Center"
                                 Fill="{StaticResource ErrorBrush}" />
                        <TextBlock Text="{Binding StatusBar.PingStatus}" FontSize="13"
                                   Foreground="{Binding StatusBar.ConnectionDotColor}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="  " FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusBar.ConnectionStatusText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{Binding StatusBar.ConnectionStatusColor}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="磁盘容量" Style="{StaticResource StatusMetricLabel}" Margin="0,0,0,4" Foreground="{StaticResource OnDarkBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock Text="C盘：" Foreground="{StaticResource OnDarkBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusBar.CDriveInfo}" FontSize="13" Foreground="{StaticResource OnDarkBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="D盘：" Foreground="{StaticResource OnDarkBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusBar.DDriveInfo}" FontSize="13" Foreground="{StaticResource OnDarkBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="本地时间" Style="{StaticResource StatusMetricLabel}" HorizontalAlignment="Right" Margin="0,0,0,2" Foreground="{StaticResource OnDarkBrush}" />
                        <TextBlock Text="{Binding StatusBar.CurrentTime}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OnDarkBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- LOG AREA -->
            <Border Grid.Row="1" Style="{StaticResource DarkPanel}"
                    AllowDrop="True" PreviewDragOver="ScriptDrop_PreviewDragOver" Drop="ScriptDrop_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="12,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="日志级别" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OnDarkBrush}" />
                            <ComboBox ItemsSource="{Binding Log.LogLevels}" SelectedItem="{Binding Log.SelectedFilterLevel}" Width="92" Height="30" FontSize="12"
                                      Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" BorderBrush="{StaticResource SurfaceDarkElevatedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="清空日志" Command="{Binding Log.ClearLogCommand}" MinWidth="82" Height="34" FontSize="13" Style="{StaticResource BtnBlue}" />
                            <Button Content="复制日志" Click="CopyLogButton_Click" MinWidth="82" Height="34" FontSize="13" Margin="8,0,0,0" Style="{StaticResource BtnCyan}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceDarkElevatedBrush}" Padding="8,5" Margin="12,0,12,0" CornerRadius="3"
                            AllowDrop="True" PreviewDragOver="ScriptDrop_PreviewDragOver" Drop="ScriptDrop_Drop">
                        <TextBlock Text="拖拽脚本文件到此可发送到目标主机远程执行" TextWrapping="NoWrap"
                                    FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentAzureBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3"
                                 Visibility="{Binding Log.IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="12,0,12,0" />

                    <RichTextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" Background="{StaticResource SurfaceDarkBrush}" Foreground="{StaticResource OnDarkBrush}" BorderThickness="0"
                                 AllowDrop="True" PreviewDragOver="ScriptDrop_PreviewDragOver" Drop="ScriptDrop_Drop"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="4"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 IsUndoEnabled="False">
                        <RichTextBox.ContextMenu>
                            <ContextMenu Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" Padding="0">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="{StaticResource SurfaceDarkElevatedBrush}"
                                                BorderBrush="{StaticResource HairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="2">
                                            <StackPanel IsItemsHost="True" />
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="OverridesDefaultStyle" Value="True" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            BorderThickness="0"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter ContentSource="Header"
                                                                          RecognizesAccessKey="True"
                                                                          Margin="0"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource OnDarkSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="复制   Ctrl+C" Click="LogCopyMenuItem_Click" />
                                <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                                    <MenuItem.Template>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border Background="{StaticResource HairlineBrush}" Height="1" Margin="8,3,8,3" />
                                        </ControlTemplate>
                                    </MenuItem.Template>
                                </MenuItem>
                                <MenuItem Header="全选   Ctrl+A" Click="LogSelectAllMenuItem_Click" />
                                <MenuItem Header="清空日志" Click="LogClearMenuItem_Click" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </Grid>
            </Border>

            <!-- COMMAND TERMINAL -->
            <Border Grid.Row="3" Style="{StaticResource DarkPanel}" Padding="2"
                    AllowDrop="True" PreviewDragOver="ScriptDrop_PreviewDragOver" Drop="ScriptDrop_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="远程命令终端输入区" TextWrapping="NoWrap" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OnDarkBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="交互执行" IsChecked="{Binding Terminal.IsInteractiveMode}"
                                      Foreground="{StaticResource OnDarkBrush}" Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Terminal.ShellOptions}"
                                      SelectedItem="{Binding Terminal.SelectedShell}"
                                      Width="120" Height="28" Margin="0,0,8,0"
                                      FontSize="11" VerticalContentAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Terminal.AvailableSessions}"
                                      SelectedItem="{Binding Terminal.SelectedSession}"
                                      Width="180" Height="28"
                                      Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" BorderBrush="{StaticResource SurfaceDarkElevatedBrush}"
                                      FontSize="11" VerticalContentAlignment="Center"
                                      Visibility="{Binding Terminal.IsInteractiveMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" x:Name="TerminalInputBox"
                             Text="{Binding Terminal.CommandText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Style="{StaticResource DarkTextBox}" FontSize="13" AllowDrop="True"
                             PreviewKeyDown="TerminalInputBox_PreviewKeyDown"
                             PreviewDragOver="ScriptDrop_PreviewDragOver" Drop="ScriptDrop_Drop" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="强制结束" Command="{Binding Terminal.CancelCommand}"
                                MinWidth="88" Height="34" Style="{StaticResource BtnRed}" />
                        <Button Content="加载脚本" Command="{Binding Terminal.LoadScriptCommand}"
                                MinWidth="92" Height="34" Margin="8,0,0,0" Style="{StaticResource LimeButton}" />
                        <Button Content="执行" Command="{Binding Terminal.ExecuteCommandCommand}" MinWidth="76" Height="34" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
