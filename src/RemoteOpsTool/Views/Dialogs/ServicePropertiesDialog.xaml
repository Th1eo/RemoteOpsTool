<Window x:Class="RemoteOpsTool.Views.Dialogs.ServicePropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务属性" Height="520" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="#3399FF" />
            <TextBlock Text="{Binding ServiceName}" FontSize="12" Foreground="#AAA" Margin="0,2,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="#2A2A2A" BorderBrush="#444" Margin="0,0,0,10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#1A1A1A" />
                    <Setter Property="Foreground" Value="#AAA" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="14,6" />
                    <Setter Property="BorderBrush" Value="#444" />
                    <Setter Property="BorderThickness" Value="1,1,1,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2D2D2D" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="BorderBrush" Value="#3399FF" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#252525" />
                                        <Setter Property="Foreground" Value="#E0E0E0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- ====== 常规 ====== -->
            <TabItem Header="常规">
                <TabItem.Resources>
                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#CCC"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14,8" Background="#2A2A2A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="描述：" Foreground="#AAA" />
                        <TextBox Grid.Row="1" Text="{Binding Description}" IsReadOnly="True" Height="40"
                                 TextWrapping="Wrap" AcceptsReturn="True" Background="#222" BorderBrush="#444"/>

                        <TextBlock Grid.Row="2" Text="可执行文件路径：" Margin="0,8,0,0" Foreground="#AAA"/>
                        <TextBox Grid.Row="3" Text="{Binding BinaryPath}" IsReadOnly="True" Height="26"
                                 Background="#222" BorderBrush="#444"/>

                        <Grid Grid.Row="4" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Text="启动参数：" Foreground="#AAA" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding StartParams}" Height="26"
                                     Background="#222" BorderBrush="#444"/>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="启动类型：" VerticalAlignment="Center" Foreground="#AAA"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding StartTypes}"
                                      SelectedItem="{Binding SelectedStartType}" Height="28"
                                      Background="#222" Foreground="#E0E0E0" BorderBrush="#444"/>
                        </Grid>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="服务状态：" VerticalAlignment="Center" Foreground="#AAA"/>
                            <TextBlock Text="{Binding ServiceStatus}" VerticalAlignment="Center" FontWeight="Bold"
                                       Margin="4,0,0,0" Foreground="{Binding StatusColor}" FontSize="14"/>
                            <Button Content="启动" Command="{Binding StartServiceCommand}" Width="60" Height="28" Margin="14,0,4,0"
                                    Background="#1A6E3E" Foreground="#FFF" BorderBrush="#2EA85A"
                                    IsEnabled="{Binding CanStart}" FontSize="12"/>
                            <Button Content="停止" Command="{Binding StopServiceCommand}" Width="60" Height="28"
                                    Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030"
                                    IsEnabled="{Binding CanStop}" FontSize="12"/>
                            <Button Content="暂停" Command="{Binding PauseServiceCommand}" Width="60" Height="28" Margin="4,0,4,0"
                                    Background="#8C5A1E" Foreground="#FFF" BorderBrush="#BF8030"
                                    IsEnabled="{Binding CanPause}" FontSize="12"/>
                            <Button Content="恢复" Command="{Binding ResumeServiceCommand}" Width="60" Height="28"
                                    Background="#1A5C8A" Foreground="#FFF" BorderBrush="#2E7ABF"
                                    IsEnabled="{Binding CanResume}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ====== 登录 ====== -->
            <TabItem Header="登录">
                <TabItem.Resources>
                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#CCC"/><Setter Property="FontSize" Value="13"/></Style>
                    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#E0E0E0"/><Setter Property="FontSize" Value="13"/></Style>
                    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E0E0E0"/></Style>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14,8" Background="#2A2A2A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <RadioButton Grid.Row="0" Content="本地系统账户" IsChecked="{Binding UseLocalSystem}" GroupName="LogOn" Margin="0,0,0,8"/>
                        <CheckBox Grid.Row="1" Content="允许服务与桌面交互" IsChecked="{Binding AllowDesktopInteract}"
                                  Margin="22,0,0,10" IsEnabled="{Binding UseLocalSystem}"/>

                        <RadioButton Grid.Row="2" Content="此账户：" IsChecked="{Binding UseThisAccount}" GroupName="LogOn"/>
                        <Grid Grid.Row="3" IsEnabled="{Binding UseThisAccount}" Margin="22,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="账户：" VerticalAlignment="Center" Foreground="#AAA"/>
                            <TextBox Grid.Column="1" Text="{Binding LogOnAccount}" Height="28" Background="#222" BorderBrush="#444"/>
                            <Button Grid.Column="2" Content="浏览" Width="48" Height="28" Margin="6,0,0,0"
                                    Background="#333" Foreground="#E0E0E0" BorderBrush="#555" FontSize="12"
                                    Command="{Binding BrowseAccountCommand}" Cursor="Hand"/>
                            <TextBlock Grid.Row="1" Text="密码：" VerticalAlignment="Center" Margin="0,10,0,0" Foreground="#AAA"/>
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="LogOnPassword" Height="28" Margin="0,10,0,0"
                                         Background="#222" BorderBrush="#444"/>
                            <TextBlock Grid.Row="2" Text="确认：" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="#AAA"/>
                            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="LogOnConfirm" Height="28" Margin="0,8,0,0"
                                         Background="#222" BorderBrush="#444"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ====== 恢复 ====== -->
            <TabItem Header="恢复">
                <TabItem.Resources>
                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#CCC"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,6,0,2"/></Style>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14,8" Background="#2A2A2A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="第一次失败：" Grid.Row="0"/>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding FailureActions}" SelectedItem="{Binding FirstFailure}"
                                  Height="28" Background="#222" Foreground="#E0E0E0" BorderBrush="#444"/>
                        <TextBlock Text="第二次失败：" Grid.Row="2" Margin="0,10,0,2"/>
                        <ComboBox Grid.Row="3" ItemsSource="{Binding FailureActions}" SelectedItem="{Binding SecondFailure}"
                                  Height="28" Background="#222" Foreground="#E0E0E0" BorderBrush="#444"/>
                        <TextBlock Text="后续失败：" Grid.Row="4" Margin="0,10,0,2"/>
                        <ComboBox Grid.Row="5" ItemsSource="{Binding FailureActions}" SelectedItem="{Binding SubsequentFailure}"
                                  Height="28" Background="#222" Foreground="#E0E0E0" BorderBrush="#444"/>

                        <Grid Grid.Row="7" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="重置失败计数：" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ResetFailDays}" Height="26"
                                     Background="#222" BorderBrush="#444" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="天 之后" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <Grid Grid.Row="8" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="重新启动服务：" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding RestartMinutes}" Height="26"
                                     Background="#222" BorderBrush="#444" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="分钟 之后" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ====== 依存关系 ====== -->
            <TabItem Header="依存关系">
                <TabItem.Resources>
                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#CCC"/></Style>
                </TabItem.Resources>
                <Grid Margin="14,8" Background="#2A2A2A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="此服务依赖以下系统组件：" FontWeight="Bold" Margin="0,0,0,4" Foreground="#3399FF"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Dependencies}" Background="#222" BorderBrush="#444" Foreground="#E0E0E0"/>
                    <TextBlock Grid.Row="2" Text="以下系统组件依赖此服务：" FontWeight="Bold" Margin="0,10,0,4" Foreground="#3399FF"/>
                    <ListBox Grid.Row="3" ItemsSource="{Binding DependentServices}" Background="#222" BorderBrush="#444" Foreground="#E0E0E0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="应用" Command="{Binding ApplyCommand}" Width="75" Height="30"
                    Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4" FontSize="13"/>
            <Button Content="确定" Command="{Binding OkCommand}" Width="75" Height="30" Margin="8,0,0,0"
                    Background="#1A6E3E" Foreground="#FFF" BorderBrush="#2EA85A" FontSize="13"/>
            <Button Content="取消" Click="Cancel_Click" Width="75" Height="30" Margin="8,0,0,0"
                    Background="#555" Foreground="#E0E0E0" BorderBrush="#666" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
