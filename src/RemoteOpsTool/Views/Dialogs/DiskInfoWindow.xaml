<Window x:Class="RemoteOpsTool.Views.Dialogs.DiskInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="磁盘信息" Height="300" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource SurfaceDarkBrush}"
       >

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                     Foreground="{StaticResource SuccessBrush}" Background="{StaticResource SurfaceDarkSoftBrush}" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Disks}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2F80FF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2F80FF" />
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="盘符" Binding="{Binding DeviceId}" Width="80" />
                <DataGridTextColumn Header="可用空间 (GB)" Binding="{Binding FreeGB, StringFormat={}{0:F2}}" Width="130" />
                <DataGridTextColumn Header="总空间 (GB)" Binding="{Binding SizeGB, StringFormat={}{0:F2}}" Width="130" />
                <DataGridTextColumn Header="已用 %" Binding="{Binding UsagePercent, StringFormat={}{0:F1}}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>

