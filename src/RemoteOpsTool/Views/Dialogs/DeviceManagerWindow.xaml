<Window x:Class="RemoteOpsTool.Views.Dialogs.DeviceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="设备管理器" Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
       
        Closing="Window_Closing"
        Background="{StaticResource SurfaceDarkBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="28"
                     Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}"
                     VerticalContentAlignment="Center" Padding="4,0"
                     Style="{StaticResource {x:Type TextBox}}" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" />
            <Button Content="禁用" Command="{Binding DisableSelectedCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="{StaticResource AccentAmberBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource AccentAmberBrush}" />
            <Button Content="启用" Command="{Binding EnableSelectedCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="{StaticResource SuccessBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource SuccessBrush}" />
            <Button Content="卸载" Command="{Binding UninstallSelectedCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="{StaticResource ErrorBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource ErrorBrush}" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                     Foreground="{StaticResource SuccessBrush}" Background="{StaticResource SurfaceDarkSoftBrush}" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredDevices}"
                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                 
                   GridLinesVisibility="All" HorizontalGridLinesBrush="{StaticResource HairlineSoftBrush}"
                   VerticalGridLinesBrush="{StaticResource HairlineSoftBrush}"
                    HeadersVisibility="Column" ColumnHeaderHeight="40" CanUserResizeColumns="True" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                   PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                   PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CC785C" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CC785C" />
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource SurfaceDarkSoftBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" Padding="0" Closed="ContextMenu_Closed">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{StaticResource SurfaceDarkElevatedBrush}" BorderThickness="1" CornerRadius="3" Padding="2">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              Margin="0"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="{StaticResource HairlineBrush}" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="禁用设备" Command="{Binding DisableSelectedCommand}" />
                    <MenuItem Header="启用设备" Command="{Binding EnableSelectedCommand}" />
                    <MenuItem Header="卸载设备" Command="{Binding UninstallSelectedCommand}" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="{StaticResource HairlineBrush}" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="更新驱动" Command="{Binding UpdateDriverCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                        Width="36" CanUserResize="False" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                <DataGridTextColumn Header="类别" Binding="{Binding Class}" Width="120" />
                <DataGridTextColumn Header="名称" Binding="{Binding FriendlyName}" Width="*" />
                <DataGridTextColumn Header="驱动版本" Binding="{Binding DriverVersion}" Width="120" />
                <DataGridTextColumn Header="实例ID" Binding="{Binding InstanceId}" Width="250" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>



