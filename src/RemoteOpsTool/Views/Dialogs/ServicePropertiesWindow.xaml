<Window x:Class="RemoteOpsTool.Views.Dialogs.ServicePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务属性" Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
       
        FontFamily="Consolas" FontSize="13"
        Background="{StaticResource SurfaceDarkBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleBlock" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" x:Name="ConfigText" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{StaticResource SurfaceDarkBrush}" Foreground="{StaticResource SuccessBrush}" BorderThickness="0"
                 FontFamily="Consolas" FontSize="13" />
    </Grid>
</Window>

