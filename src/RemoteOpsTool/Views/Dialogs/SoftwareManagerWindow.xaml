<Window x:Class="RemoteOpsTool.Views.Dialogs.SoftwareManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="软件管理" Height="560" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#DCDCDC"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Height="30"
                    Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4" />
            <Button Content="静默卸载" Command="{Binding UninstallSilentCommand}" Width="90" Height="30" Margin="4,0,0,0"
                    Background="#8C5A1E" Foreground="#FFF" BorderBrush="#BF8030"
                    IsEnabled="{Binding CanUninstall}" />
            <Button Content="交互式卸载" Command="{Binding UninstallInteractiveCommand}" Width="100" Height="30" Margin="4,0,0,0"
                    Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030"
                    IsEnabled="{Binding CanUninstall}" />
            <CheckBox Content="深度清理" IsChecked="{Binding DeepCleanup}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="28" Margin="12,0,0,0"
                     VerticalAlignment="Center" />
            <Button Content="清理注册表" Command="{Binding DeleteRegistryKeysCommand}"
                    Width="95" Height="28" Margin="8,0,0,0"
                    Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030"
                    IsEnabled="{Binding CanDeleteRegistry}"
                    ToolTip="删除目标主机上已勾选的注册表键（危险操作）" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" Foreground="#4ECB71" Background="#333" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredSoftware}"
                  SelectedItem="{Binding SelectedSoftware, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                  Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#555"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#333"
                  VerticalGridLinesBrush="#333"
                  HeadersVisibility="Column" CanUserResizeColumns="True" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                      PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3399FF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF" />
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#252525" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu Background="#1E1E1E" BorderBrush="#555" Foreground="#E0E0E0" Padding="0" Closed="ContextMenu_Closed">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="3" Padding="2">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#E0E0E0" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              Margin="0"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3A7BD5" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#444" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="复制卸载命令" Command="{Binding CopyUninstallStringCommand}" />
                    <MenuItem Header="复制注册表键" Command="{Binding CopyRegistryKeyCommand}" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#444" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="静默卸载" Command="{Binding UninstallSilentCommand}" />
                    <MenuItem Header="交互式卸载" Command="{Binding UninstallInteractiveCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked}" Width="35" />
                <DataGridTextColumn Header="名称" Binding="{Binding Software.DisplayName}" Width="220" />
                <DataGridTextColumn Header="发行商" Binding="{Binding Software.Publisher}" Width="130" />
                <DataGridTextColumn Header="版本" Binding="{Binding Software.Version}" Width="80" />
                <DataGridTextColumn Header="注册表键" Binding="{Binding Software.RegistryKey}" Width="200" />
                <DataGridTextColumn Header="卸载命令" Binding="{Binding Software.UninstallString}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
