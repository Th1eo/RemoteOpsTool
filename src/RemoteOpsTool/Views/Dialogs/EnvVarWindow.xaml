<Window x:Class="RemoteOpsTool.Views.Dialogs.EnvVarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="环境变量编辑器" Height="540" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#DCDCDC">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="当前查看：" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#DCDCDC" FontSize="13" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                      Width="190" Height="30"
                      Background="#1A1A1A" Foreground="#E0E0E0" BorderBrush="#555" />
            <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}"
                    Width="70" Height="30" Margin="8,0,0,0"
                    Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4" />
            <TextBox Grid.Column="3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="28" Margin="12,0,0,0"
                     VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                     Foreground="#4ECB71" Background="#333" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredVariables}"
                  AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                  Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#555"
                    GridLinesVisibility="All" HorizontalGridLinesBrush="#333"
                   VerticalGridLinesBrush="#333"
                   HeadersVisibility="Column" CanUserResizeColumns="True" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                     PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                     PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3399FF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF" />
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#252525" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu Background="#1E1E1E" BorderBrush="#555" Foreground="#E0E0E0" Padding="0" Closed="ContextMenu_Closed">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="3" Padding="2">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#E0E0E0" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              Margin="0"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3A7BD5" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="新建变量" Command="{Binding AddVariableCommand}" />
                    <MenuItem Header="修改变量" Command="{Binding EditSelectedCommand}" />
                    <MenuItem Header="删除变量" Command="{Binding DeleteSelectedCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked}" Width="35" />
                <DataGridTextColumn Header="变量名" Binding="{Binding Variable.Name}" Width="200" />
                <DataGridTextColumn Header="变量值" Binding="{Binding Variable.Value}" Width="*" />
                <DataGridTextColumn Header="作用域" Binding="{Binding Variable.Target}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="添加" Command="{Binding AddVariableCommand}"
                        Width="80" Height="30" Margin="0,0,8,0"
                        Background="#1A6E3E" Foreground="#FFF" BorderBrush="#2EA85A" />
                <Button Content="修改所选" Command="{Binding EditSelectedCommand}"
                        Width="85" Height="30" Margin="0,0,8,0"
                        Background="#1A5C8A" Foreground="#FFF" BorderBrush="#2E7ABF"
                        IsEnabled="{Binding CanEditSelected}" />
                <Button Content="删除所选" Command="{Binding DeleteSelectedCommand}"
                        Width="85" Height="30"
                        Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030"
                        IsEnabled="{Binding CanDeleteSelected}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
