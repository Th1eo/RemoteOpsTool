<Window x:Class="RemoteOpsTool.Views.Dialogs.ServiceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="服务管理器" Height="520" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#DCDCDC"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="28"
                     Background="#2D2D2D" Foreground="#DCDCDC" BorderBrush="#555"
                     VerticalContentAlignment="Center" Padding="4,0" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4" />
            <Button Content="启动" Command="{Binding StartSelectedCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="#1A6E3E" Foreground="#FFF" BorderBrush="#2EA85A" />
            <Button Content="停止" Command="{Binding StopSelectedCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="#8C5A1E" Foreground="#FFF" BorderBrush="#BF8030" />
            <Button Content="重启" Command="{Binding RestartSelectedCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                     Foreground="#4ECB71" Background="#333" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredEntries}"
                  SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                  Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#444"
                    GridLinesVisibility="All" HorizontalGridLinesBrush="#333"
                   VerticalGridLinesBrush="#333"
                   HeadersVisibility="Column" ColumnHeaderHeight="28" CanUserResizeColumns="True" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3399FF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF" />
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#252525" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu Background="#1E1E1E" BorderBrush="#555" Foreground="#E0E0E0" Padding="0" Closed="ContextMenu_Closed">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="3" Padding="2">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#E0E0E0" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              Margin="0"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3A7BD5" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#444" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="启动服务" Command="{Binding StartSelectedCommand}" />
                    <MenuItem Header="停止服务" Command="{Binding StopSelectedCommand}" />
                    <MenuItem Header="重启服务" Command="{Binding RestartSelectedCommand}" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#444" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="属性" Command="{Binding ShowPropertiesCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                        Width="36" CanUserResize="False" />
                <DataGridTextColumn Header="服务名" Binding="{Binding ServiceName}" Width="160" />
                <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="100" />
                <DataGridTextColumn Header="启动类型" Binding="{Binding StartType}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
