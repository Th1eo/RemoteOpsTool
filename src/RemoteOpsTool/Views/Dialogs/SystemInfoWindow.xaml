<Window x:Class="RemoteOpsTool.Views.Dialogs.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="系统信息" Height="700" Width="960"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing"
        Background="{StaticResource SurfaceDarkBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                     Foreground="{StaticResource SuccessBrush}" Background="{StaticResource SurfaceDarkSoftBrush}" />

        <!-- Error message -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceDarkElevatedBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="错误" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Query method badge + Header -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding QueryMethodInfo}" FontSize="11" Foreground="{StaticResource MutedSoftBrush}"
                       HorizontalAlignment="Right"
                       Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}" />

            <Border Grid.Row="1" Background="{StaticResource SurfaceDarkElevatedBrush}" CornerRadius="4" Padding="14,10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="主机名：" Foreground="{StaticResource MutedSoftBrush}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding InfoData.HostName}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding InfoData.OsCaption}" FontSize="14"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Main selectable info text area -->
        <RichTextBox x:Name="InfoRichTextBox" Grid.Row="3"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="{StaticResource SurfaceDarkBrush}"
                     Foreground="{StaticResource OnDarkBrush}"
                     BorderBrush="{StaticResource SurfaceDarkElevatedBrush}"
                     BorderThickness="1"
                     Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}"
                     ContextMenuOpening="InfoTextBox_ContextMenuOpening">
            <RichTextBox.ContextMenu>
                <ContextMenu Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" Padding="0" Closed="ContextMenu_Closed">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{StaticResource SurfaceDarkElevatedBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="2">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              Margin="0"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource OnDarkSoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="复制   Ctrl+C" Click="CopyMenuItem_Click" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="{StaticResource HairlineBrush}" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="全选   Ctrl+A" Click="SelectAllMenuItem_Click" />
                </ContextMenu>
            </RichTextBox.ContextMenu>
        </RichTextBox>

        <!-- Raw Output -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceDarkElevatedBrush}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
            <Expander Header="原始输出 Raw Output" Foreground="{StaticResource MutedSoftBrush}" FontSize="12" IsExpanded="False">
                <TextBox Text="{Binding SystemInfoText}"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Visible" MinHeight="200" MaxHeight="400"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}" FontSize="11"
                         Background="{StaticResource SurfaceDarkBrush}" Foreground="{StaticResource SuccessBrush}" BorderThickness="0" />
            </Expander>
        </Border>
    </Grid>
</Window>
