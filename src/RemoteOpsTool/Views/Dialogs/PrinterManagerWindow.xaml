<Window x:Class="RemoteOpsTool.Views.Dialogs.PrinterManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="打印机管理" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#DCDCDC"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Height="28"
                    Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4" />
            <Button Content="删除" Command="{Binding RemoveSelectedCommand}" Width="70" Height="28" Margin="4,0,0,0"
                    Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030" />
            <Button Content="设为默认" Command="{Binding SetDefaultCommand}" Width="90" Height="28" Margin="4,0,0,0"
                    Background="#1A5C8A" Foreground="#FFF" BorderBrush="#2E7ABF"
                    IsEnabled="{Binding CanSetDefault}" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="26" Margin="12,0,0,0"
                     VerticalAlignment="Center" Background="#2D2D2D" Foreground="#DCDCDC"
                     BorderBrush="#555" CaretBrush="#DCDCDC" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="添加：" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding NewPrinterConnection}" Height="26" />
            <Button Grid.Column="2" Content="添加" Command="{Binding AddPrinterCommand}" Width="55" Height="26"
                    Background="#1A6E3E" Foreground="#FFF" BorderBrush="#2EA85A" />
        </Grid>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" Foreground="#4ECB71" Background="#333" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredPrinters}"
                  SelectedItem="{Binding SelectedPrinter}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                  Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#555"
                    GridLinesVisibility="All" HorizontalGridLinesBrush="#333"
                   VerticalGridLinesBrush="#333"
                   HeadersVisibility="Column" CanUserResizeColumns="True" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                      PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3399FF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF" />
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#252525" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <Setter Property="Background" Value="#3399FF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu Background="#1E1E1E" BorderBrush="#555" Foreground="#E0E0E0" Padding="0" Closed="ContextMenu_Closed">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="3" Padding="2">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#E0E0E0" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              Margin="0"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3A7BD5" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#444" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="设为默认" Command="{Binding SetDefaultCommand}" />
                    <MenuItem Header="删除打印机" Command="{Binding RemoveSelectedCommand}" />
                    <MenuItem IsEnabled="False" Height="2" Padding="0" Margin="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#444" Height="1" Margin="8,3,8,3" />
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    <MenuItem Header="打印机属性" Command="{Binding OpenPrinterPropertiesCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked}" Width="40" />
                <DataGridTextColumn Header="名称" Binding="{Binding Printer.Name}" Width="180" />
                <DataGridTextColumn Header="驱动程序" Binding="{Binding Printer.DriverName}" Width="180" />
                <DataGridTextColumn Header="端口" Binding="{Binding Printer.PortName}" Width="120" />
                <DataGridCheckBoxColumn Header="共享" Binding="{Binding Printer.Shared}" Width="55" />
                <DataGridCheckBoxColumn Header="默认" Binding="{Binding Printer.Default}" Width="55" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
