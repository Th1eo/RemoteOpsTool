<Window x:Class="RemoteOpsTool.Views.Dialogs.DiskCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="磁盘清理" Height="520" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource SurfaceDarkBrush}"
       >

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="预设清理目录" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource HairlineBrush}" Padding="4">
            <ListBox ItemsSource="{Binding Items}" Background="{StaticResource SurfaceDarkSoftBrush}" Foreground="{StaticResource OnDarkBrush}" BorderThickness="0" MaxHeight="150">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="3">
                            <CheckBox IsChecked="{Binding IsChecked}" />
                            <TextBlock Text="{Binding Description}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontWeight="Bold" />
                            <TextBlock Text=" — " Foreground="{StaticResource MutedSoftBrush}" />
                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedSoftBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="自定义清理目标" Foreground="{StaticResource AccentLimeBrush}" BorderBrush="{StaticResource HairlineBrush}" Padding="6">
            <StackPanel>
                <TextBlock Text="一行一个文件、目录或通配符，例如 C:\Temp\*.log（支持 * 和 ?）" FontSize="11" Foreground="{StaticResource MutedSoftBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding CustomDirectories, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="80"
                         VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                         Padding="6,4"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         Background="{StaticResource SurfaceDarkSoftBrush}" Foreground="{StaticResource OnDarkBrush}" BorderBrush="{StaticResource HairlineBrush}"
                         ToolTip="一行一个文件、目录或通配符路径；支持 * 和 ?" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Margin="0,10,0,0"
                    Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}"
                         Height="12" Foreground="{StaticResource SuccessBrush}"
                         Background="{StaticResource SurfaceDarkSoftBrush}" />
            <TextBlock Text="{Binding ProgressText}" Margin="0,5,0,0"
                       Foreground="{StaticResource MutedSoftBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button Grid.Row="5" Content="开始清理" Command="{Binding CleanupCommand}"
                Width="110" Height="36" HorizontalAlignment="Right" Margin="0,10,0,0"
                Background="{StaticResource ErrorBrush}" Foreground="{StaticResource OnPrimaryBrush}"
                BorderBrush="{StaticResource ErrorBrush}" FontSize="14">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCleaning}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>

