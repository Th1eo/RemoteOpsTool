<Window x:Class="RemoteOpsTool.Views.Dialogs.DiskCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘清理" Height="520" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#1E1E1E" Foreground="#DCDCDC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="预设清理目录" Foreground="#569CD6" BorderBrush="#444" Padding="4">
            <ListBox ItemsSource="{Binding Items}" Background="#111" BorderThickness="0" MaxHeight="150">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="3">
                            <CheckBox IsChecked="{Binding IsChecked}" />
                            <TextBlock Text="{Binding Description}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontWeight="Bold" />
                            <TextBlock Text=" — " Foreground="#666" />
                            <TextBlock Text="{Binding Path}" Foreground="#888" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="自定义清理目录" Foreground="#D4A853" BorderBrush="#444" Padding="6">
            <StackPanel>
                <TextBlock Text="一行一个目录路径，例如 C:\Temp" FontSize="11" Foreground="#888"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding CustomDirectories, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="80"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         Background="#111" Foreground="#DCDCDC" BorderBrush="#444"
                         ToolTip="输入自定义目录路径，一行一个" />
            </StackPanel>
        </GroupBox>

        <Button Grid.Row="4" Content="开始清理" Command="{Binding CleanupCommand}"
                Width="110" Height="32" HorizontalAlignment="Right" Margin="0,10,0,0"
                Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030" FontSize="14" />
    </Grid>
</Window>
