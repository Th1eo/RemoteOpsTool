<Window x:Class="RemoteOpsTool.Views.Dialogs.NetworkPortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="进程管理" Height="700" Width="1200"
        WindowStartupLocation="CenterOwner"
       
        Closing="Window_Closing"
        Background="{StaticResource SurfaceDarkBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ProcessManagerRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource SurfaceDarkSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
            <Setter Property="MinHeight" Value="30" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBlueBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBlueBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="刷新" Command="{Binding RefreshCommand}"
                    Width="60" Height="32" Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                    Margin="0,0,8,0" FontSize="13" />
            <Button Content="结束进程" Command="{Binding KillProcessCommand}"
                    Width="80" Height="32" Background="{StaticResource ErrorBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource ErrorBrush}"
                    Margin="0,0,8,0" FontSize="13" />
            <Button Content="结束进程树" Command="{Binding KillProcessTreeCommand}"
                    Width="90" Height="32" Background="{StaticResource ErrorBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource ErrorBrush}"
                    Margin="0,0,8,0" FontSize="13" />
            <Button Content="重启进程" Command="{Binding RestartProcessCommand}"
                    Width="90" Height="32" Background="{StaticResource WarningBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource WarningBrush}"
                    Margin="0,0,8,0" FontSize="13" ToolTip="终止选中的单个进程后，按原启动方式重新创建" />
            <Button Content="注销所选用户" Command="{Binding SignOutSelectedUserCommand}"
                    Width="100" Height="32" Background="{StaticResource AccentLimeBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource AccentLimeBrush}"
                    Margin="0,0,8,0" FontSize="13" />
            <TextBlock Text="用户筛选:" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="12" />
            <ComboBox ItemsSource="{Binding UserFilters}" SelectedItem="{Binding SelectedUserFilter}"
                      Width="120" Height="28"
                      Background="{StaticResource SurfaceDarkSoftBrush}" Foreground="{StaticResource OnDarkBrush}"
                      FontSize="12" VerticalContentAlignment="Center" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="150" Height="28" Margin="12,0,0,0"
                     Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}"
                     FontSize="12" VerticalContentAlignment="Center"
                     Padding="6,0" />
            <CheckBox Content="实时刷新" IsChecked="{Binding IsAutoRefreshEnabled}"
                      Foreground="{StaticResource OnDarkBrush}" Margin="12,0,4,0"
                      VerticalAlignment="Center" FontSize="12" />
            <ComboBox ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshIntervalSeconds}"
                      Width="58" Height="28"
                      Background="{StaticResource SurfaceDarkSoftBrush}" Foreground="{StaticResource OnDarkBrush}"
                      FontSize="12" VerticalContentAlignment="Center" />
            <TextBlock Text="秒" VerticalAlignment="Center" Margin="4,0,10,0" FontSize="12" Foreground="{StaticResource OnDarkSoftBrush}" />
            <TextBlock Text="{Binding LastRefreshText}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource OnDarkSoftBrush}" MinWidth="120" />
        </StackPanel>

        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Foreground="{StaticResource SuccessBrush}" Background="{StaticResource SurfaceDarkSoftBrush}"
                     Margin="0,0,0,4" />

        <!-- Main content area: user sessions on top, processes below -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- User sessions section -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceDarkElevatedBrush}" BorderThickness="1"
                    Margin="0,0,0,4" CornerRadius="3" Padding="4"
                    Visibility="{Binding HasUsers, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="登录用户会话" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                               Margin="4,2,0,4" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UserSessions}"
                              AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                             
                               HeadersVisibility="Column" ColumnHeaderHeight="32" GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource ProcessManagerRowStyle}"
                              RowHeight="30"
                              MaxHeight="220"
                              PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1597FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1597FF" />
                        </DataGrid.Resources>
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" Padding="0" Closed="ContextMenu_Closed">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="{StaticResource SurfaceDarkElevatedBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="3" Padding="2">
                                            <StackPanel IsItemsHost="True" />
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            BorderThickness="0">
                                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="注销用户" Command="{Binding SignOutUserCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="35" />
                            <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="130" />
                            <DataGridTextColumn Header="会话名" Binding="{Binding SessionName}" Width="100" />
                            <DataGridTextColumn Header="会话ID" Binding="{Binding SessionId}" Width="70" />
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80" />
                            <DataGridTextColumn Header="空闲时间" Binding="{Binding IdleTime}" Width="100" />
                            <DataGridTextColumn Header="登录时间" Binding="{Binding LogonTime}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Separator Grid.Row="1" Height="6" Background="Transparent" />

            <!-- Process list section -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredProcesses}"
                      AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                      HeadersVisibility="Column" ColumnHeaderHeight="32"
                      GridLinesVisibility="Horizontal"
                      RowStyle="{StaticResource ProcessManagerRowStyle}"
                      RowHeight="30"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1597FF" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1597FF" />
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" Padding="0" Closed="ContextMenu_Closed">
                        <ContextMenu.Template>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Background="{StaticResource SurfaceDarkElevatedBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="3" Padding="2">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </ControlTemplate>
                        </ContextMenu.Template>
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
                                <Setter Property="Padding" Value="12,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="Border"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderThickness="0">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource OnDarkSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                        <Separator>
                            <Separator.Template>
                                <ControlTemplate TargetType="Separator">
                                    <Border Background="{StaticResource HairlineBrush}" Height="1" Margin="8,4,8,4" />
                                </ControlTemplate>
                            </Separator.Template>
                        </Separator>
                        <MenuItem Header="结束进程" Command="{Binding KillProcessCommand}" />
                        <MenuItem Header="结束进程树" Command="{Binding KillProcessTreeCommand}" />
                        <MenuItem Header="重启进程" Command="{Binding RestartProcessCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="35" />
                    <DataGridTextColumn Header="进程名" Binding="{Binding ProcessName}" Width="180" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                    <DataGridTextColumn Header="会话" Binding="{Binding SessionName}" Width="80" />
                    <DataGridTextColumn Header="内存(MB)" Binding="{Binding MemoryMB}" Width="80" />
                    <DataGridTextColumn Header="CPU时间" Binding="{Binding CpuTime}" Width="100" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                    <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="120" />
                    <DataGridTextColumn Header="路径" Binding="{Binding ExecutablePath}" Width="230" />
                    <DataGridTextColumn Header="窗口标题" Binding="{Binding WindowTitle}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>



