<Window x:Class="RemoteOpsTool.Views.Dialogs.NetworkPortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="进程管理" Height="640" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#DCDCDC"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="刷新" Command="{Binding RefreshCommand}"
                    Width="60" Height="28" Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4"
                    Margin="0,0,8,0" FontSize="12" />
            <Button Content="结束进程" Command="{Binding KillProcessCommand}"
                    Width="80" Height="28" Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030"
                    Margin="0,0,8,0" FontSize="12" />
            <Button Content="结束进程树" Command="{Binding KillProcessTreeCommand}"
                    Width="90" Height="28" Background="#B91C1C" Foreground="#FFF" BorderBrush="#EF4444"
                    Margin="0,0,8,0" FontSize="12" />
            <Button Content="注销所选用户" Command="{Binding SignOutSelectedUserCommand}"
                    Width="100" Height="28" Background="#D97706" Foreground="#FFF" BorderBrush="#F59E0B"
                    Margin="0,0,8,0" FontSize="12" />
            <TextBlock Text="用户筛选:" VerticalAlignment="Center" Margin="16,0,4,0" FontSize="12" />
            <ComboBox ItemsSource="{Binding UserFilters}" SelectedItem="{Binding SelectedUserFilter}"
                      Width="120" Height="28"
                      Background="#1A1A1A" Foreground="#E0E0E0" BorderBrush="#555"
                      FontSize="12" VerticalContentAlignment="Center" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="180" Height="28" Margin="16,0,0,0"
                     Background="#222" Foreground="#E0E0E0" BorderBrush="#444"
                     FontSize="12" VerticalContentAlignment="Center"
                     Padding="6,0" />
        </StackPanel>

        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Foreground="#4ECB71" Background="#333"
                     Margin="0,0,0,4" />

        <!-- Main content area: user sessions on top, processes below -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- User sessions section -->
            <Border Grid.Row="0" Background="#252525" BorderBrush="#444" BorderThickness="1"
                    Margin="0,0,0,4" CornerRadius="3" Padding="4"
                    Visibility="{Binding HasUsers, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="登录用户会话" FontWeight="Bold" FontSize="12" Foreground="#4ECB71"
                               Margin="4,2,0,4" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UserSessions}"
                              AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#555"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#333" MaxHeight="220"
                              PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3399FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF" />
                        </DataGrid.Resources>
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#1E1E1E" BorderBrush="#555" Foreground="#E0E0E0" Padding="0" Closed="ContextMenu_Closed">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="3" Padding="2">
                                            <StackPanel IsItemsHost="True" />
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#E0E0E0" />
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            BorderThickness="0">
                                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#3A7BD5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="注销用户" Command="{Binding SignOutUserCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="35" />
                            <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="130" />
                            <DataGridTextColumn Header="会话名" Binding="{Binding SessionName}" Width="100" />
                            <DataGridTextColumn Header="会话ID" Binding="{Binding SessionId}" Width="70" />
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80" />
                            <DataGridTextColumn Header="空闲时间" Binding="{Binding IdleTime}" Width="100" />
                            <DataGridTextColumn Header="登录时间" Binding="{Binding LogonTime}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Separator Grid.Row="1" Height="6" Background="Transparent" />

            <!-- Process list section -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredProcesses}"
                      AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                      Background="#1E1E1E" Foreground="#DCDCDC" BorderBrush="#555"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3399FF" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3399FF" />
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu Background="#1E1E1E" BorderBrush="#555" Foreground="#E0E0E0" Padding="0" Closed="ContextMenu_Closed">
                        <ContextMenu.Template>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="3" Padding="2">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </ControlTemplate>
                        </ContextMenu.Template>
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#E0E0E0" />
                                <Setter Property="Padding" Value="12,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="Border"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderThickness="0">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3A7BD5" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#666" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                        <Separator>
                            <Separator.Template>
                                <ControlTemplate TargetType="Separator">
                                    <Border Background="#444" Height="1" Margin="8,4,8,4" />
                                </ControlTemplate>
                            </Separator.Template>
                        </Separator>
                        <MenuItem Header="结束进程" Command="{Binding KillProcessCommand}" />
                        <MenuItem Header="结束进程树" Command="{Binding KillProcessTreeCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="35" />
                    <DataGridTextColumn Header="进程名" Binding="{Binding ProcessName}" Width="180" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                    <DataGridTextColumn Header="会话" Binding="{Binding SessionName}" Width="80" />
                    <DataGridTextColumn Header="内存(MB)" Binding="{Binding MemoryMB}" Width="80" />
                    <DataGridTextColumn Header="CPU时间" Binding="{Binding CpuTime}" Width="100" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                    <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="120" />
                    <DataGridTextColumn Header="窗口标题" Binding="{Binding WindowTitle}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
