<Window x:Class="RemoteOpsTool.Views.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级设置" Height="700" Width="720"
        MinHeight="620" MinWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource SurfaceDarkBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel>
                <!-- PsExec Tool Management -->
                <GroupBox Header="PsExec 工具管理" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource HairlineBrush}"
                  Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="状态：" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock Text="{Binding PsToolsStatus}" VerticalAlignment="Center" FontSize="14"
                               FontWeight="Bold" Foreground="{Binding PsToolsStatusColor}" />
                </StackPanel>

                <TextBlock Text="PsExec 是远程命令和交互程序的首选通道；不可用时，程序会按功能自动回退到 WMI/DCOM。"
                           Foreground="{StaticResource MutedSoftBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="工具路径：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PsToolsPath}" />
        <Button Grid.Column="2" Content="浏览" Command="{Binding BrowsePsToolsCommand}"
                Width="55" Height="32" Margin="6,0,0,0"
                Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" BorderBrush="{StaticResource SurfaceDarkElevatedBrush}" />
                </Grid>

                <UniformGrid Columns="4" Rows="1">
                    <Button Content="配置" Command="{Binding ConfigurePsToolsCommand}" Margin="3"
                            Height="36" Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                            ToolTip="从微软官方路径下载并配置 PsExec" />
                    <Button Content="更新" Command="{Binding UpdatePsToolsCommand}" Margin="3"
                            Height="36" Background="{StaticResource SuccessBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource SuccessBrush}"
                            ToolTip="卸载旧版本后下载最新版" />
                    <Button Content="卸载" Command="{Binding UninstallPsToolsCommand}" Margin="3"
                            Height="36" Background="{StaticResource ErrorBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource ErrorBrush}"
                            ToolTip="卸载 PsExec 并删除残留文件" />
                    <Button Content="手动下载" Command="{Binding OpenPsToolsDownloadCommand}" Margin="3"
                            Height="36" Background="{StaticResource AccentLimeBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource AccentLimeBrush}"
                            ToolTip="打开微软 PsTools 官方下载页面" />
                </UniformGrid>
            </StackPanel>
        </GroupBox>

                <!-- Other Path Config -->
                <GroupBox Header="其他工具路径配置" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource HairlineBrush}" Padding="12">
            <StackPanel>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DameWare 路径：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding DameWarePath}" />
        <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseDameWareCommand}"
                Width="55" Height="32" Margin="6,0,0,0"
                Background="{StaticResource SurfaceDarkElevatedBrush}" Foreground="{StaticResource OnDarkBrush}" BorderBrush="{StaticResource SurfaceDarkElevatedBrush}" />
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="域公共目录路径：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding DomainPublicPath}" />
                </Grid>
                <CheckBox IsChecked="{Binding DebugMode}" Foreground="{StaticResource BodyBrush}" Margin="4,10,0,4"
                          Content="调试模式 — 输出所有命令及返回数据，用于排查问题" FontSize="12" />
                <CheckBox IsChecked="{Binding PreferPsExec64}" Foreground="{StaticResource BodyBrush}" Margin="4,4,0,4"
                          Content="优先使用 PsExec64.exe" FontSize="12" />
                <CheckBox IsChecked="{Binding PreferWmiForRemoteCommands}" Foreground="{StaticResource BodyBrush}" Margin="4,4,0,4"
                          Content="远程长命令/清理脚本优先使用 WMI/DCOM；短命令使用 PsExec 流式执行" FontSize="12" />
                <CheckBox IsChecked="{Binding OmitPsExecExplicitCredentialsWhenRunAs}" Foreground="{StaticResource BodyBrush}" Margin="4,4,0,4"
                          Content="PsExec 已使用运维凭据 RunAs 时，默认省略命令行 -u/-p（避免密码暴露）" FontSize="12" />
                <StackPanel Orientation="Horizontal" Margin="4,6,0,0">
                    <TextBlock Text="PsExec 连接超时：" VerticalAlignment="Center" />
                    <TextBox Text="{Binding PsExecConnectTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                             Width="48" Margin="6,0,4,0" />
                    <TextBlock Text="秒" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Margin="4,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="远端工作目录：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PsExecRemoteWorkingDirectory}" />
                </Grid>
                <Grid Margin="4,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="临时服务前缀：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PsExecServiceNamePrefix}" />
                </Grid>
            </StackPanel>
        </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="保存设置" Command="{Binding SaveCommand}"
                Width="110" Height="34" HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource OnPrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" FontSize="14" />
    </Grid>
</Window>
