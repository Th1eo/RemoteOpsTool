<Window x:Class="RemoteOpsTool.Views.Dialogs.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凭据管理" Height="500" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#1E1E1E" Foreground="#DCDCDC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="添加凭据" Margin="0,0,0,12" Foreground="#569CD6"
                  BorderBrush="#555" BorderThickness="2">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}" FontSize="14" FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}" Margin="0,0,0,8" />
                            <ContentPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <StackPanel>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="域名：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding NewDomain}" Height="28" />
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="用户名：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding NewUserName}" Height="28" />
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="密码：" VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="HiddenPasswordBox" Height="28"
                                     PasswordChar="●" Background="#2A2A2A" Foreground="#E0E0E0"
                                     BorderBrush="#444" BorderThickness="1"
                                     VerticalContentAlignment="Center" />
                        <TextBox x:Name="VisiblePasswordBox" Height="28"
                                 Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                    <Button Grid.Column="2" x:Name="EyeBtn" Click="EyeBtn_Click"
                            Width="38" Height="28" Margin="6,0,0,0"
                            Background="Transparent" BorderBrush="#555" BorderThickness="1"
                            Foreground="#DCDCDC" FontSize="15" Cursor="Hand"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="0">
                        <TextBlock x:Name="EyeIcon" Text="👁" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="描述：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding NewDescription}" Height="28" />
                </Grid>
                <Button Content="添加" Command="{Binding AddCredentialCommand}"
                        Width="70" Height="30" HorizontalAlignment="Right" Margin="4"
                        Background="#0E639C" Foreground="#FFF" BorderBrush="#1E8AD4" FontSize="13" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="当前运维凭据（单选）" Foreground="#569CD6"
                  BorderBrush="#555" BorderThickness="2">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}" FontSize="14" FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}" Margin="0,0,0,8" />
                            <ContentPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding Credentials}" SelectionMode="Extended" Background="#111">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="3">
                                <RadioButton GroupName="OpsCredential"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,10,0,0">
                    <Button Content="删除所选" Command="{Binding DeleteSelectedCommand}"
                            Width="90" Height="30" Background="#8B1E1E" Foreground="#FFF" BorderBrush="#C53030" />
                    <Button Content="清空全部" Command="{Binding ClearAllCommand}"
                            Width="90" Height="30" Margin="8,0,0,0"
                            Background="#701818" Foreground="#FFF" BorderBrush="#A02020" />
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
