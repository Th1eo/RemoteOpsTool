<Window x:Class="RemoteOpsTool.Views.Dialogs.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RemoteOpsTool.Converters"
        Title="凭据管理" Height="760" Width="760"
        MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource SurfaceDarkBrush}">

    <Window.Resources>
        <converters:CredentialHealthToBrushConverter x:Key="CredentialHealthToBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CredentialGroup" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" FontSize="14" FontWeight="Bold"
                                           Foreground="{TemplateBinding Foreground}" Margin="0,0,0,8" />
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="添加或更新凭据" Style="{StaticResource CredentialGroup}">
            <StackPanel>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="域名：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding NewDomain}" Height="28" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="用户名：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Text="{Binding NewUserName}" Height="28" />
                </Grid>

                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="密码：" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <PasswordBox x:Name="HiddenPasswordBox" Height="28"
                                     PasswordChar="●" VerticalContentAlignment="Center" />
                        <TextBox x:Name="VisiblePasswordBox" Height="28"
                                 Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                    <Button Grid.Column="3" x:Name="EyeBtn" Click="EyeBtn_Click"
                            Width="38" Height="32" Margin="6,0,0,0"
                            Background="Transparent" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                            Foreground="{StaticResource BodyBrush}" FontSize="15" Cursor="Hand"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="0">
                        <TextBlock x:Name="EyeIcon" Text="👁" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="描述：" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding NewDescription}" Height="28" />
                </Grid>

                <Grid Margin="4,8,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="更新已有凭据：在上方输入新密码，选中列表中的凭据后点击“更新密码”。"
                               Style="{StaticResource CaptionText}" Foreground="{StaticResource OnDarkSoftBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="添加并设为当前" Command="{Binding AddCredentialCommand}"
                            MinWidth="120" Height="34" HorizontalAlignment="Right" Margin="12,0,0,0"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="当前运维身份" Style="{StaticResource CredentialGroup}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding CurrentCredentialText}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource OnDarkBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Margin="12,0,0,0" Padding="10,4" CornerRadius="12"
                        Background="{Binding CurrentCredentialHealth, Converter={StaticResource CredentialHealthToBrush}}">
                    <TextBlock Text="{Binding CurrentCredentialHealthText}"
                               Foreground="{StaticResource OnPrimaryBrush}" FontWeight="SemiBold" />
                </Border>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding CurrentCredentialDetailText}"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource OnDarkSoftBrush}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                           Text="{Binding CurrentCredentialLastValidatedText}"
                           Margin="0,6,0,0"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource OnDarkSoftBrush}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="本机凭据列表" Style="{StaticResource CredentialGroup}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding Credentials}"
                         SelectedItem="{Binding ListSelectedCredential, Mode=TwoWay}"
                         SelectionMode="Single"
                         IsSynchronizedWithCurrentItem="False"
                         MinHeight="180"
                         Background="{StaticResource SurfaceDarkSoftBrush}"
                         Foreground="{StaticResource OnDarkBrush}"
                         BorderBrush="{StaticResource HairlineBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource OnDarkBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastUsedText}"
                                               Margin="0,3,0,0"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource OnDarkSoftBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                    <Border Margin="0,0,0,4"
                                            Padding="9,3"
                                            CornerRadius="10"
                                            Background="{StaticResource PrimaryBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="当前身份"
                                                   Foreground="{StaticResource OnPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <Border Padding="9,3" CornerRadius="10"
                                            Background="{Binding Health, Converter={StaticResource CredentialHealthToBrush}}">
                                        <TextBlock Text="{Binding HealthText}"
                                                   Foreground="{StaticResource OnPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding LastValidatedText}"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource OnDarkSoftBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,10,0,0">
                    <Button Content="设为当前" Command="{Binding SetCurrentCredentialCommand}"
                            MinWidth="90" Height="34" Margin="0,0,8,0"
                            Style="{StaticResource BtnIndigo}" />
                    <Button Content="{Binding ValidateButtonText}" Command="{Binding ValidateSelectedCredentialCommand}"
                            MinWidth="90" Height="34" Margin="0,0,8,0"
                            Style="{StaticResource BtnBlue}" />
                    <Button Content="更新密码" Command="{Binding UpdateSelectedPasswordCommand}"
                            MinWidth="90" Height="34" Margin="0,0,8,0"
                            Style="{StaticResource BtnGreen}" />
                    <Button Content="删除所选" Command="{Binding DeleteSelectedCommand}"
                            MinWidth="90" Height="34" Margin="0,0,8,0"
                            Style="{StaticResource BtnRed}" />
                    <Button Content="清空全部" Command="{Binding ClearAllCommand}"
                            MinWidth="90" Height="34"
                            Style="{StaticResource BtnRed}" />
                </WrapPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
