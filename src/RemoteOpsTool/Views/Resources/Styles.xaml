<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Design tokens, adapted from docs/DESIGN.md for a dense WPF ops console ===== -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Font/09_SourceHanSansSC/OTF/SimplifiedChinese/#Source Han Sans SC, pack://application:,,,/Font/JetBrainsMono-2.304/fonts/ttf/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Font/09_SourceHanSansSC/OTF/SimplifiedChinese/#Source Han Sans SC, pack://application:,,,/Font/JetBrainsMono-2.304/fonts/ttf/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Font/JetBrainsMono-2.304/fonts/ttf/#JetBrains Mono, pack://application:,,,/Font/09_SourceHanSansSC/OTF/SimplifiedChinese/#Source Han Sans SC</FontFamily>
    <FontFamily x:Key="CjkFont">pack://application:,,,/Font/09_SourceHanSansSC/OTF/SimplifiedChinese/#Source Han Sans SC</FontFamily>

    <Color x:Key="ColorPrimary">#D12B37</Color>
    <Color x:Key="ColorPrimaryActive">#A91E29</Color>
    <Color x:Key="ColorPrimaryDisabled">#4A515B</Color>
    <Color x:Key="ColorInk">#F3F4F6</Color>
    <Color x:Key="ColorBody">#E5E7EB</Color>
    <Color x:Key="ColorBodyStrong">#FFFFFF</Color>
    <Color x:Key="ColorMuted">#AAB2BD</Color>
    <Color x:Key="ColorMutedSoft">#7F8996</Color>
    <Color x:Key="ColorHairline">#3A424D</Color>
    <Color x:Key="ColorHairlineSoft">#2B323B</Color>
    <Color x:Key="ColorCanvas">#0D1014</Color>
    <Color x:Key="ColorSurfaceSoft">#151A20</Color>
    <Color x:Key="ColorSurfaceCard">#1B2128</Color>
    <Color x:Key="ColorSurfaceCreamStrong">#20272F</Color>
    <Color x:Key="ColorSurfaceDark">#0F1318</Color>
    <Color x:Key="ColorSurfaceDarkElevated">#1A2027</Color>
    <Color x:Key="ColorSurfaceDarkSoft">#141A20</Color>
    <Color x:Key="ColorOnPrimary">#FFFFFF</Color>
    <Color x:Key="ColorOnDark">#F3F4F6</Color>
    <Color x:Key="ColorOnDarkSoft">#AAB2BD</Color>
    <Color x:Key="ColorAccentAzure">#356D9A</Color>
    <Color x:Key="ColorAccentLime">#48745A</Color>
    <Color x:Key="ColorAccentLimeActive">#365944</Color>
    <Color x:Key="ColorAccentPurple">#74568D</Color>
    <Color x:Key="ColorAccentPurpleActive">#583F6D</Color>
    <Color x:Key="ColorAccentIndigo">#50658A</Color>
    <Color x:Key="ColorAccentIndigoActive">#3C4C69</Color>
    <Color x:Key="ColorAccentCyan">#327785</Color>
    <Color x:Key="ColorAccentCyanActive">#285D68</Color>
    <Color x:Key="ColorAccentMagenta">#A83B59</Color>
    <Color x:Key="ColorAccentMagentaActive">#812D45</Color>
    <Color x:Key="ColorSelectionBlue">#D12B37</Color>
    <Color x:Key="ColorButtonBlue">#356D9A</Color>
    <Color x:Key="ColorSuccess">#347A4D</Color>
    <Color x:Key="ColorTerminalSuccess">#72D58B</Color>
    <Color x:Key="ColorWarning">#B6812E</Color>
    <Color x:Key="ColorError">#C63B32</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource ColorPrimaryActive}" />
    <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="{StaticResource ColorPrimaryDisabled}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="BodyBrush" Color="{StaticResource ColorBody}" />
    <SolidColorBrush x:Key="BodyStrongBrush" Color="{StaticResource ColorBodyStrong}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="MutedSoftBrush" Color="{StaticResource ColorMutedSoft}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource ColorHairline}" />
    <SolidColorBrush x:Key="HairlineSoftBrush" Color="{StaticResource ColorHairlineSoft}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource ColorSurfaceSoft}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource ColorSurfaceCard}" />
    <SolidColorBrush x:Key="SurfaceCreamStrongBrush" Color="{StaticResource ColorSurfaceCreamStrong}" />
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource ColorSurfaceDark}" />
    <SolidColorBrush x:Key="SurfaceDarkElevatedBrush" Color="{StaticResource ColorSurfaceDarkElevated}" />
    <SolidColorBrush x:Key="SurfaceDarkSoftBrush" Color="{StaticResource ColorSurfaceDarkSoft}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource ColorOnPrimary}" />
    <SolidColorBrush x:Key="OnDarkBrush" Color="{StaticResource ColorOnDark}" />
    <SolidColorBrush x:Key="OnDarkSoftBrush" Color="{StaticResource ColorOnDarkSoft}" />
    <SolidColorBrush x:Key="AccentAzureBrush" Color="{StaticResource ColorAccentAzure}" />
    <SolidColorBrush x:Key="AccentLimeBrush" Color="{StaticResource ColorAccentLime}" />
    <SolidColorBrush x:Key="AccentLimeActiveBrush" Color="{StaticResource ColorAccentLimeActive}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource ColorAccentPurple}" />
    <SolidColorBrush x:Key="AccentPurpleActiveBrush" Color="{StaticResource ColorAccentPurpleActive}" />
    <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource ColorAccentIndigo}" />
    <SolidColorBrush x:Key="AccentIndigoActiveBrush" Color="{StaticResource ColorAccentIndigoActive}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="AccentCyanActiveBrush" Color="{StaticResource ColorAccentCyanActive}" />
    <SolidColorBrush x:Key="AccentMagentaBrush" Color="{StaticResource ColorAccentMagenta}" />
    <SolidColorBrush x:Key="AccentMagentaActiveBrush" Color="{StaticResource ColorAccentMagentaActive}" />
    <SolidColorBrush x:Key="SelectionBlueBrush" Color="{StaticResource ColorSelectionBlue}" />
    <SolidColorBrush x:Key="ButtonBlueBrush" Color="{StaticResource ColorButtonBlue}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="TerminalSuccessBrush" Color="{StaticResource ColorTerminalSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C1121F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#C1121F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />

    <!-- ===== 全局基础样式 ===== -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource SurfaceDarkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource SelectionBlueBrush}" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource OnDarkSoftBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceDarkSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CaretBrush" Value="{StaticResource OnDarkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="6,4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource TerminalSuccessBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TerminalSuccessBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource SurfaceDarkSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceDarkElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryActiveBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource OnDarkSoftBrush}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryActiveBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource PrimaryDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SurfaceDarkElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SurfaceDarkElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
